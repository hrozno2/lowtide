{
  "name": "low-tide",
  "productName": "Low Tide",
  "version": "1.0.9",
  "description": "A fast, minimal novel writing app.",
  "main": "src/main/main.js",
  "author": "hrozno2",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:renderer": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "dist": "npm run build:renderer && electron-builder -mwl",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:linux": "npm run build:renderer && electron-builder --linux",
    "dist:win:publish": "npm run build:renderer && electron-builder --win --publish always",
    "dist:linux:publish": "npm run build:renderer && electron-builder --linux --publish always",
    "icon": "electron scripts/icon.js",
    "shot": "electron scripts/shot.js",
    "pack": "npm run build:renderer && electron-builder --dir",
    "test": "npm run test:unit && npm run test:app",
    "test:unit": "node scripts/unit.mjs",
    "test:app": "npm run build:renderer && electron scripts/selftest.js",
    "notices": "node scripts/notices.mjs",
    "palette": "node scripts/palette.mjs",
    "contrast": "node scripts/contrast.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true
  },
  "build": {
    "appId": "com.lowtide.writer",
    "productName": "Low Tide",
    "copyright": "Copyright © 2026",
    "artifactName": "LowTide-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/*.html",
      "src/renderer/css/**/*",
      "src/renderer/dist/**/*",
      "src/renderer/fonts/**/*",
      "src/renderer/audio/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "fileAssociations": [
      {
        "ext": "fountain",
        "name": "Fountain Document",
        "description": "Plain-text manuscript",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Low Tide"
    },
    "linux": {
      "category": "Office",
      "synopsis": "A fast, minimal novel writing app",
      "desktop": {
        "StartupWMClass": "low-tide",
        "Categories": "Office;WordProcessor;"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "hrozno2 <hrozno2@users.noreply.github.com>",
      "vendor": "hrozno2",
      "description": "A fast, minimal novel writing app.",
      "mimeTypes": [
        "text/plain",
        "text/markdown"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib"
      ]
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "afterPack": "build/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "hrozno2",
      "repo": "lowtide",
      "releaseType": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hrozno2/lowtide.git"
  },
  "homepage": "https://github.com/hrozno2/lowtide"
}
